{
  "name": "nexus-exchange",
  "private": true,
  "description": "Nexus-Exchange — full-stack crypto exchange with matching engine, order book, wallets, and real-time WebSocket market data",
  "version": "1.0.0",
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/web",
    "apps/server",
    "packages/types",
    "packages/config"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "web": "turbo run dev --filter=web",
    "server": "turbo run dev --filter=server"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.6",
    "typescript": "^5.5.0"
  }
}
